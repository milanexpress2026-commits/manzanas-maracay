{
  "name": "manzanas-maracay",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @mm/api && npm run build -w @mm/web",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && npm run typecheck -w @mm/web",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "node scripts/postgres.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "db:stop": "node scripts/stop-db.mjs",
    "format": "prettier --write apps/web/src apps/api/src packages/domain/src packages/database/src scripts tests docs *.md *.json *.ts *.yaml"
  },
  "dependencies": {
    "dotenv": "18.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
